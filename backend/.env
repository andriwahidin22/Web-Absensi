
# PostgreSQL Connection Variables
DB_USER=andriwahidin
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Db-Absensi

# # Prisma DATABASE_URL composed using variables (use dotenv-expand or similar if needed)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRE="24h"

# Server
PORT=5001
NODE_ENV=development

# Upload
UPLOAD_PATH="uploads/"

# Frontend
FRONTEND_URL="http://localhost:8080"
